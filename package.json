{
  "name": "k6-typescript-template",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal TypeScript starter for reliable k6 load tests.",
  "license": "Apache-2.0",
  "author": "Sergio Cuadros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sacuadros/k6-typescript-template.git"
  },
  "keywords": [
    "k6",
    "load-testing",
    "performance-testing",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run test:inspect",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run check",
    "test:inspect": "k6 inspect src/smoke.ts",
    "test:smoke": "k6 run src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/k6": "2.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
